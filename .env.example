# ---------------------------------------------------------------------------
# Frontend (Vite) — values are baked into the client bundle at build time.
# ---------------------------------------------------------------------------

# Public HTTPS base URL that QR codes point to (no trailing slash).
# Must be reachable from the phones scanning the QR code.
# Leave empty during local development to fall back to the current browser origin
# (the admin will warn you that the resulting QR code is local-only).
VITE_PUBLIC_APP_URL=

# Base URL of the API server when it is hosted on a different origin than the
# frontend. Leave empty when the Node server serves both (recommended).
VITE_API_BASE_URL=

# Set to "true" to serve the Vite dev server over HTTPS with a self-signed
# certificate, so phones on the same Wi-Fi can open the camera during testing.
VITE_DEV_HTTPS=false

# ---------------------------------------------------------------------------
# Backend (Node / Express)
# ---------------------------------------------------------------------------

# Port of the API server. In production it also serves the built frontend.
PORT=8787

# Shared secret required for all admin write operations.
# REQUIRED in production (NODE_ENV=production). In development it may be left
# empty, in which case the admin API is open (local use only).
ADMIN_TOKEN=

# Directory where experience metadata and uploaded assets are stored.
# Must be on persistent storage in production.
DATA_DIR=./server/data

# Comma-separated list of origins allowed to call the API cross-origin
# (only needed when VITE_API_BASE_URL points to a different origin).
CORS_ORIGINS=

# Maximum size of a single upload, in megabytes.
MAX_UPLOAD_MB=60
