{
  "name": "webar-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mind-ar": "^1.2.5",
    "multer": "^2.5.0",
    "nanoid": "^5.1.16",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.186.1"
  },
  "overrides": {
    "mind-ar": {
      "canvas": "npm:@favware/skip-dependency@1.2.2"
    }
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.6",
    "vite": "^7.3.7"
  }
